[[ "${BASH_SOURCE[0]}" == "${0}" ]] && { echo "FATAL"; exit 99; }

set -o nounset
set -o pipefail

export ANSIBOOT_ENV_VERSION="1.0.0"
export ANSIBOOT_ENV_LOADED=1

if [[ -n "${__ANSIBOOT_DEFAULTS_LOADED:-}" ]]; then
  return 0
fi
export __ANSIBOOT_DEFAULTS_LOADED=1

export ANSIBOOT_NAME="Ansiboot"
export ANSIBOOT_NAMESPACE="ansiboot"
export ANSIBOOT_AUTHOR="internal"
export ANSIBOOT_MODE="bootstrap"

export ANSIBOOT_ROOT_DIR="${ANSIBOOT_ROOT_DIR:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"

export ANSIBOOT_BIN_DIR="${ANSIBOOT_ROOT_DIR}/bin"
export ANSIBOOT_LIB_DIR="${ANSIBOOT_ROOT_DIR}/lib"
export ANSIBOOT_CONFIG_DIR="${ANSIBOOT_ROOT_DIR}/config"
export ANSIBOOT_LOG_DIR="${ANSIBOOT_ROOT_DIR}/logs"
export ANSIBOOT_CACHE_DIR="${ANSIBOOT_ROOT_DIR}/.cache"
export ANSIBOOT_TMP_DIR="${ANSIBOOT_ROOT_DIR}/.tmp"

for __d in "${ANSIBOOT_LOG_DIR}" "${ANSIBOOT_CACHE_DIR}" "${ANSIBOOT_TMP_DIR}"
do
  [[ -d "${__d}" ]] || mkdir -p "${__d}" 2>/dev/null || true
done
unset __d

export ANSIBOOT_LOG_LEVEL="${ANSIBOOT_LOG_LEVEL:-INFO}"
export ANSIBOOT_LOG_ROTATE_SIZE="${ANSIBOOT_LOG_ROTATE_SIZE:-1048576}"
export ANSIBOOT_LOG_FILE="${ANSIBOOT_LOG_DIR}/ansiboot.log"
export ANSIBOOT_LOG_TIMESTAMP_FORMAT="%Y-%m-%d %H:%M:%S"
export ANSIBOOT_LOG_COLOR=1
export ANSIBOOT_LOG_STDERR=1

export DRY_RUN="${DRY_RUN:-0}"
export ANSIBOOT_CONFIRM_ACTIONS=1
export ANSIBOOT_FAIL_FAST=1
export ANSIBOOT_SILENT=0

export ANSIBOOT_SHELL="/usr/bin/env bash"
export ANSIBOOT_UMASK=027
umask "${ANSIBOOT_UMASK}"

export ANSIBOOT_ALLOW_SUDO=1
export ANSIBOOT_REQUIRE_ROOT=0
export ANSIBOOT_SANITIZE_ENV=1

export BIN_ANSIBLE="${BIN_ANSIBLE:-ansible}"
export BIN_ANSIBLE_PLAYBOOK="${BIN_ANSIBLE_PLAYBOOK:-ansible-playbook}"
export BIN_SSH="${BIN_SSH:-ssh}"
export BIN_SCP="${BIN_SCP:-scp}"
export BIN_GIT="${BIN_GIT:-git}"
export BIN_AWK="${BIN_AWK:-awk}"
export BIN_SED="${BIN_SED:-sed}"
export BIN_GREP="${BIN_GREP:-grep}"

export ANSIBOOT_SSH_USER="${ANSIBOOT_SSH_USER:-root}"
export ANSIBOOT_SSH_PORT="${ANSIBOOT_SSH_PORT:-22}"
export ANSIBOOT_SSH_TIMEOUT=10
export ANSIBOOT_SSH_STRICT_HOST_KEY_CHECKING="accept-new"
export ANSIBOOT_SSH_KEY_TYPE="ed25519"
export ANSIBOOT_SSH_KEY_BITS=4096
export ANSIBOOT_SSH_KEY_PATH="${ANSIBOOT_CACHE_DIR}/ansiboot_ssh_key"

export ANSIBOOT_INVENTORY_DIR="${ANSIBOOT_ROOT_DIR}/inventory"
export ANSIBOOT_INVENTORY_FILE="${ANSIBOOT_INVENTORY_DIR}/hosts.ini"
export ANSIBOOT_DEFAULT_GROUP="bootstrap"
export ANSIBOOT_PARALLEL_FORKS=5

export ANSIBOOT_PING_TIMEOUT=2
export ANSIBOOT_RETRY_COUNT=3
export ANSIBOOT_RETRY_DELAY=1

export FEATURE_AUTO_SSH_KEYGEN=1
export FEATURE_AUTO_INVENTORY=1
export FEATURE_CONN_TEST=1
export FEATURE_ADHOC_CMD=1
export FEATURE_COLOR_OUTPUT=1

export __ANSIBOOT_TRUE=1
export __ANSIBOOT_FALSE=0

export __ANSIBOOT_IFS_BACKUP="${IFS}"
IFS=$' \t\n'

__ansiboot_validate_defaults() {
  local __err=0
  [[ -d "${ANSIBOOT_ROOT_DIR}" ]] || __err=1
  [[ -n "${ANSIBOOT_LOG_FILE}" ]] || __err=1
  [[ "${DRY_RUN}" =~ ^(0|1)$ ]] || __err=1
  return "${__err}"
}

__ansiboot_validate_defaults || { echo "FATAL"; return 98; }

unset -f __ansiboot_validate_defaults
